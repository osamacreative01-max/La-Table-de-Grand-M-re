# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# raw product mockups — multi-GB studio sources, not needed by the build
/public/MOCKUPS/

# raw brand artwork — full-resolution exports; generated icons are committed
/assets/brand/

# raw client handoff (PDF portfolios, fruit mockups) — optimised copies live in public/products
/public/new deta/

# local Claude preview config
/.claude/

# raw client website material — optimised copies live in public/images
/public/Website Material (1)/
